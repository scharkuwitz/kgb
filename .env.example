# OPENAI_API_KEY=
# Optional overrides (defaults shown)
# KGB_DATA=data
# KGB_DB=data/kgb.sqlite
# KGB_WORK=data/work
# KGB_TRIAGE_MODEL=gpt-6-luna
# KGB_EXTRACT_MODEL=gpt-6-luna
# KGB_JUDGE_MODEL=gpt-6-luna
# KGB_META_MODEL=gpt-6-luna   # default: same as KGB_TRIAGE_MODEL
# KGB_EMBED_MODEL=text-embedding-3-small
# KGB_EMBED_DIM=512
# KGB_WORKERS=8
# KGB_RENDER_PX=2000
# KGB_TRIAGE_PX=768
# KGB_META_PX=1280
# KGB_EXTRACT_DETAIL=original
# HTTP API (uv run python -m kgb.api). Keep comments on their own lines: .env values are taken verbatim.
# Host: 0.0.0.0 to serve the office LAN.
# API key: when set, requests need the header X-API-Key (all routes but /health and the docs).
# Max upload: largest PDF in MB accepted by POST /contracts.
# KGB_API_HOST=127.0.0.1
# KGB_API_PORT=8000
# KGB_API_KEY=
# KGB_MAX_UPLOAD_MB=50
